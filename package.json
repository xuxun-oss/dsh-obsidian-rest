{
  "name": "dsh-obsidian-rest",
  "version": "0.1.0",
  "description": "DeepSeek Harness (dsh) 插件：通过用户自配的 Obsidian Local REST API，为 dsh agent 提供 vault 远程读取/搜索/写入能力（remote-REST-first，可选 Cloudflare Access 双头）。",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "cordis",
    "plugin",
    "obsidian",
    "obsidian-local-rest-api",
    "rest",
    "vault",
    "notes"
  ],
  "type": "module",
  "author": "Xun Xu <xuxun-oss@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xuxun-oss/dsh-obsidian-rest.git"
  },
  "bugs": {
    "url": "https://github.com/xuxun-oss/dsh-obsidian-rest/issues"
  },
  "homepage": "https://github.com/xuxun-oss/dsh-obsidian-rest#readme",
  "engines": {
    "node": ">=18"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "SKILL.md",
    "CHANGELOG.md"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.1",
    "@types/node": "^18.19.0",
    "typescript": "^5.7.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs",
    "mock": "node scripts/mock-server.mjs",
    "smoke": "node scripts/rest-smoke.mjs",
    "prepublishOnly": "npm run build"
  }
}